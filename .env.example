# Configuration des APIs de paiement
# Copiez ce fichier vers .env et remplissez les valeurs réelles

# Stripe (paiements par carte)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_SUCCESS_URL=http://127.0.0.1:8000/paiement/paiement_success.html
STRIPE_CANCEL_URL=http://127.0.0.1:8000/paiement/paiement_cancel.html

# Wave Mobile Money
WAVE_CLIENT_ID=your_wave_client_id_here
WAVE_CLIENT_SECRET=your_wave_client_secret_here
WAVE_WEBHOOK_SECRET=your_wave_webhook_secret_here
WAVE_SUCCESS_URL=http://127.0.0.1:8000/paiement/paiement_success.html
WAVE_CANCEL_URL=http://127.0.0.1:8000/paiement/paiement_cancel.html

# Orange Money
ORANGE_MONEY_CLIENT_ID=your_orange_money_client_id_here
ORANGE_MONEY_CLIENT_SECRET=your_orange_money_client_secret_here
ORANGE_MONEY_MERCHANT_KEY=your_orange_money_merchant_key_here
ORANGE_MONEY_WEBHOOK_SECRET=your_orange_money_webhook_secret_here
ORANGE_MONEY_SUCCESS_URL=http://127.0.0.1:8000/paiement/paiement_success.html
ORANGE_MONEY_CANCEL_URL=http://127.0.0.1:8000/paiement/paiement_cancel.html

# Lemfi
LEMFY_API_KEY=your_lemfi_api_key_here
LEMFY_SECRET_KEY=your_lemfi_secret_key_here
LEMFY_WEBHOOK_SECRET=your_lemfi_webhook_secret_here
LEMFY_SUCCESS_URL=http://127.0.0.1:8000/paiement/paiement_success.html
LEMFY_CANCEL_URL=http://127.0.0.1:8000/paiement/paiement_cancel.html